#!/bin/bash

# Gradle wrapper script

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

# Check if java is available
if ! command -v "$JAVACMD" &> /dev/null ; then
    echo "Error: Java not found. Please set JAVA_HOME or add java to PATH."
    exit 1
fi

# Set GRADLE_HOME if not set
if [ -z "$GRADLE_HOME" ] ; then
    # Try to find gradle in common locations
    if [ -d "/opt/gradle" ] ; then
        GRADLE_HOME="/opt/gradle"
    elif [ -d "$HOME/.gradle/wrapper/dists" ] ; then
        # Find the newest distribution that actually has a runnable binary;
        # stale/incomplete wrapper dirs (e.g. gradle-8.5-bin) are skipped.
        for candidate in $(find "$HOME/.gradle/wrapper/dists" -maxdepth 2 -name "gradle-*" -type d | sort -V -r) ; do
            if [ -x "$candidate/bin/gradle" ] ; then
                GRADLE_HOME="$candidate"
                break
            fi
        done
    fi
fi

# If GRADLE_HOME is still not set, try to download gradle wrapper
if [ -z "$GRADLE_HOME" ] || [ ! -d "$GRADLE_HOME" ] ; then
    echo "Gradle not found. Please install Gradle or set GRADLE_HOME."
    echo "You can install Gradle using:"
    echo "  brew install gradle"
    echo "  or"
    echo "  sdk install gradle"
    exit 1
fi

# Execute gradle
exec "$GRADLE_HOME/bin/gradle" "$@"
