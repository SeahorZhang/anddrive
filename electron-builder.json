{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "com.anddrive.next",
  "asar": true,
  "productName": "AndDrive",
  "afterPack": "scripts/after-pack.js",
  "electronLanguages": [
    "zh-CN",
    "en-US"
  ],
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "extraResources": [
    {
      "from": "resources/helper-app.apk",
      "to": "helper-app.apk"
    }
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${arch}-${version}-Installer.${ext}",
    "extraResources": [
      {
        "from": "resources/adb/mac/adb",
        "to": "adb/mac/adb"
      },
      {
        "from": "resources/scrcpy",
        "to": "scrcpy",
        "filter": [
          "scrcpy",
          "scrcpy-server"
        ]
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${arch}-${version}-Setup.${ext}",
    "extraResources": [
      {
        "from": "resources/adb/win",
        "to": "adb/win",
        "filter": [
          "adb.exe",
          "AdbWinApi.dll",
          "AdbWinUsbApi.dll"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${arch}-${version}.${ext}",
    "extraResources": [
      {
        "from": "resources/adb/linux/adb",
        "to": "adb/linux/adb"
      }
    ]
  }
}
