{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "com.anddrive.next",
  "asar": true,
  "productName": "AndDrive",
  "afterPack": "scripts/after-pack.js",
  "electronLanguages": [
    "zh-CN",
    "en-US"
  ],
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "extraResources": [
    {
      "from": "resources/helper-app.apk",
      "to": "helper-app.apk"
    }
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${arch}-${version}-Installer.${ext}",
    "extraResources": [
      {
        "from": "resources/adb/mac/adb",
        "to": "adb/mac/adb"
      },
      {
        "from": "resources/scrcpy",
        "to": "scrcpy",
        "filter": [
          "scrcpy",
          "scrcpy-server"
        ]
      }
    ]
  }
}
