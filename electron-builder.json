{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "com.anddrive.next",
  "asar": true,
  "productName": "AndDrive",
  "afterPack": "scripts/after-pack.js",
  "protocols": [
    {
      "name": "AndDrive Mirror",
      "schemes": [
        "anddrive"
      ]
    }
  ],
  "electronLanguages": [
    "zh-CN",
    "en-US"
  ],
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "node_modules/@yume-chan/**"
  ],
  "extraResources": [
    {
      "from": "resources/helper-app.apk",
      "to": "helper-app.apk"
    }
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${arch}-${version}-Installer.${ext}",
    "identity": "AndDrive Self-Signed",
    "extendInfo": {
      "NSLocalNetworkUsageDescription": "AndDrive 需要访问本地网络，以通过 mDNS 发现并连接同一网络下的 Android 设备。",
      "NSBonjourServices": [
        "_adb-tls-connect._tcp",
        "_adb-tls-pairing._tcp"
      ],
      "UTExportedTypeDeclarations": [
        {
          "UTTypeIdentifier": "com.anddrive.mirror-shortcut",
          "UTTypeDescription": "AndDrive 投屏快捷方式",
          "UTTypeConformsTo": [
            "public.data"
          ],
          "UTTypeIconFile": "electron.icns",
          "UTTypeTagSpecification": {
            "public.filename-extension": [
              "adr"
            ]
          }
        }
      ],
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "AndDrive 投屏快捷方式",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Owner",
          "LSItemContentTypes": [
            "com.anddrive.mirror-shortcut"
          ],
          "CFBundleTypeExtensions": [
            "adr"
          ],
          "CFBundleTypeIconFile": "electron.icns"
        }
      ]
    },
    "extraResources": [
      {
        "from": "resources/adb/mac/adb",
        "to": "adb/mac/adb"
      },
      {
        "from": "resources/scrcpy/scrcpy-server",
        "to": "scrcpy/scrcpy-server"
      }
    ]
  }
}
